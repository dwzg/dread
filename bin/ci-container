#!/bin/sh
# The tests as CI runs them, in a podman container of an image like CI's runner (ci/NAME.containerfile,
# by default ubuntu-24.04: GCC 13 with -m32, clang 18, the cross compilers the workflow installs; CI's
# other runner is ubuntu-22.04: GCC 11, clang 14): a
# copy of this checkout's files (not .git and .venv, and as on CI not the examples' caches; --caches
# takes them along, which is faster and sees less), a venv of its own, then pytest with the arguments
# given (none: the whole suite). The host's compilers are newer than
# CI's: on 2026-10-27 GCC 15 compiled a rewritten function without touching a register GCC 11 and 13
# set, and Ubuntu's linker ended an image at its last byte where the host's padded it, and CI on main
# stayed red for two pushes. Run the tests a change touches here before pushing it.
#
#   bin/ci-container [--os ubuntu-24.04] [--caches] [PYTEST ARGUMENTS...]
set -eu
os=ubuntu-24.04
caches=--exclude=./examples/*/*/build
while :; do
    case "${1:-}" in
        --os) os=$2; shift 2 ;;
        --caches) caches=--exclude=./.git; shift ;;      # (an exclusion tar makes anyway: the caches go)
        *) break ;;
    esac
done
root=$(cd "$(dirname "$0")/.." && pwd)
file="$root/ci/$os.containerfile"
[ -f "$file" ] || { echo "ci-container: no $file" >&2; exit 2; }
image="localhost/dread-ci-$os:$(sha1sum "$file" | cut -c1-12)"     # (a changed file builds an image of its own)
podman image exists "$image" || podman build -q -t "$image" -f "$file" "$root/ci" >/dev/null
exec podman run --rm -e CACHES="$caches" -v "$root:/src:ro" "$image" sh -c '
    mkdir -p /work && cd /src && tar --exclude=./.venv --exclude=./.git "$CACHES" -cf - . | (cd /work && tar -xf -)
    cd /work && ${DREAD_CI_PYTHON:-python3} -m venv .venv
    .venv/bin/pip install -q -e ".[test,prove,dwarf]" >/tmp/pip.log 2>&1 || { tail -20 /tmp/pip.log; exit 3; }
    exec .venv/bin/python -m pytest -q -p no:cacheprovider "$@"' ci-container "$@"
